# ============================================================
# Nexo v2 — Environment Variables
# Copy to .env and fill in real values before deploying.
# ============================================================

# Server
PORT=3000
NODE_ENV=development
BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:5173
FRONTEND_AUTH_URL=http://localhost:4000

# PostgreSQL
DATABASE_URL=postgresql://username:password@localhost:5432/nexo

# Google OAuth2 + Calendar
GOOGLE_CLIENT_ID=your_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_client_secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# JWT
JWT_SECRET=change_this_in_production_min_32_chars
JWT_EXPIRES_IN=7d

# Redis (required for BullMQ job queues)
REDIS_URL=redis://localhost:6379

# Pinecone — create index with dimension=768, metric=cosine
PINECONE_API_KEY=your_pinecone_api_key
PINECONE_INDEX=nexo-contacts

# Gemini AI
GEMINI_API_KEY=your_gemini_api_key

# LinkedIn Enrichment (pick one or both — adapter tries primary first, falls back)
ENRICHMENT_PROVIDER=proxycurl
PROXYCURL_API_KEY=your_proxycurl_key
SCRAPINGDOG_API_KEY=your_scrapingdog_key

# AWS S3 — optional, but required for production CSV storage
AWS_S3_BUCKET=nexo-uploads
AWS_REGION=ap-south-1
# AWS credentials via IAM role (preferred) or keys:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# SendGrid
SENDGRID_API_KEY=SG.xxxx
SENDGRID_FROM_EMAIL=noreply@getnexo.in

# WhatsApp Cloud API
WHATSAPP_URL=https://graph.facebook.com/v17.0
WHATSAPP_PHONE_ID=your_phone_number_id
WHATSAPP_TOKEN=your_permanent_graph_token
WHATSAPP_REMINDER_TEMPLATE=reminder_notification

# Chrome Extension — shared secret for /api/extension/* routes
EXTENSION_SECRET=change_this_to_a_random_string
